{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(images|site-photos|credentials|previews)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!images/|site-photos/|credentials/|previews/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
